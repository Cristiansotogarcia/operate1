{
  "name": "@operate1/worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npx tsc",
    "service:install": "node install-service.js",
    "service:uninstall": "node uninstall-service.js",
    "package": "npx tsc && npx @yao-pkg/pkg dist/index.js --targets node20-win-x64 --output release/Operate1.exe --compress GZip"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^12.8.0",
    "systeminformation": "^5.22.9",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.7",
    "@yao-pkg/pkg": "^6.0.0",
    "node-windows": "1.0.0-beta.8",
    "tsx": "^4.10.0",
    "typescript": "^5.4.5"
  }
}
